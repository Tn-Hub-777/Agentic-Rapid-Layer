# ---------- LLM ----------
# mock   = scripted offline model, no key, no internet (used by tests/demo)
# ollama = local model, free (install Ollama, then: ollama pull qwen3:8b)
# groq   = free-tier API key from console.groq.com
# gemini = Google AI Studio API key. Recommended real-model default.
# Gemini 3.8 Flash is Google's current high-capability Flash model for agentic workflows.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# optional fallback used automatically if the primary model errors
FALLBACK_PROVIDER=
FALLBACK_MODEL=
GROQ_API_KEY=
GOOGLE_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY_HERE
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Slicer ----------
# auto = use PrusaSlicer CLI if found, else built-in estimator
# estimator = never use the slicer
SLICER=auto
PRUSA_SLICER_PATH=prusa-slicer

# ---------- Payments ----------
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=change-me-dev-secret
# Razorpay TEST mode is free: only needed if PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Printers ----------
# simulated = fake fleet (default). Per-printer OctoPrint URLs live in the printers table.
PRINTER_DRIVER=simulated

# ---------- Storage ----------
DATA_DIR=./data

# ---------- Observability (optional, free tier) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=print-agents

# ---------- API ----------
# header X-Admin-Token required for operator endpoints (print-finished, mock payment)
ADMIN_TOKEN=dev-admin-token
